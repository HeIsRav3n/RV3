{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "js/**",
          "assets/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server/index.js" }
  ]
}
