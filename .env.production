# ── PRODUCTION CONFIGURATION ──
# Copy this and update with your real values for production deployment

PORT=3000
NODE_ENV=production

# ── Server Security ──────────────────────────────
# Only this address can initialize the first administrator account.
ADMIN_EMAIL=you@example.com
# Only needed temporarily when migrating an existing legacy login.
API_SECRET=

# Required on serverless hosting; recommended everywhere.
DATABASE_URL=

# ── OpenSea (required for real contract detection) ───
OPENSEA_API_KEY=your_opensea_api_key

# ── Optional data APIs ──────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key
BLUR_API_KEY=your_blur_api_key

# ── RPC endpoints (HTTPS only) ──────────────────────
# Use your production RPC providers
ETH_RPC_PRIMARY=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_RPC_BLAST_1=https://eth-mainnet.infura.io/v3/YOUR_KEY
ETH_RPC_BLAST_2=https://quicknode-provider/YOUR_KEY
ETH_RPC_BLAST_3=https://another-rpc-provider/YOUR_KEY
ETH_RPC_PRIVATE=https://rpc.flashbots.net

# ── Flashbots bundles (optional) ────────────────────
FLASHBOTS_AUTH_PRIVATE_KEY=

# ── Alerts (optional) ───────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Wallet security ─────────────────────────────────
# 64-char hex (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Live Mint ────────────────────────────────────────
ENABLE_LIVE_MINT=true

# ── Rate Limiting ────────────────────────────────────
TASK_RATE_LIMIT_PER_MIN=10
