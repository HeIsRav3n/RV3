# ── Server ──────────────────────────────────────────────
PORT=3000
# Server-side secret; the browser authenticates through an HttpOnly session cookie.
API_SECRET=change_me_to_a_long_random_string

# One-time production bootstrap only. Set both temporarily to create the
# first (and only bootstrap) operator, then disable bootstrap mode and rotate
# the secret. RV3 rejects bootstrap registration once any user exists.
RV3_BOOTSTRAP_MODE=disabled
RV3_BOOTSTRAP_SECRET=

# ── Database (optional — enables multi-device persistence) ──
# Neon/Vercel Postgres/Supabase connection string. If unset, RV3 uses local
# JSON files under ./data. On Vercel this MUST be set (filesystem is ephemeral).
# Auth, wallets, tasks, and copy-mint targets auto-create their tables.
DATABASE_URL=

# ── OpenSea (required for real contract detection) ───
OPENSEA_API_KEY=
# OpenSea REST v2 is RV3's supported integration. The undocumented web GraphQL
# endpoint is disabled by default and must never be required for production.
OPENSEA_GRAPHQL_ENABLED=false
# Read-only public-event provider. RV3 will not auto-discover mints until an
# adapter plus source-authentication and finality policy are configured.
RV3_EVENT_PROVIDER=
# Server-only The Graph query credentials for indexed read models. These are
# optional and never replace direct RPC/event streams for FCFS triggering.
THE_GRAPH_API_KEY=
THE_GRAPH_ETHEREUM_SUBGRAPH_ID=
THE_GRAPH_ROBINHOOD_SUBGRAPH_ID=

# ── Optional data APIs ──────────────────────────────────
ETHERSCAN_API_KEY=
BLUR_API_KEY=

# ── RPC endpoints (HTTPS only) ──────────────────────────
# Primary node used for reads + first broadcast
ETH_RPC_PRIMARY=
# Extra endpoints for RPC blast (optional)
ETH_RPC_BLAST_1=
ETH_RPC_BLAST_2=
ETH_RPC_BLAST_3=
# Flashbots Protect relay (optional)
ETH_RPC_PRIVATE=https://rpc.flashbots.net

# ── Builder fan-out (optional — race broadcast to multiple builders) ──
ETH_BUILDER_TITAN=
ETH_BUILDER_BEAVER=
ETH_BUILDER_RSYNC=
ETH_BUILDER_FLASHBOTS=

# ── Multi-chain RPC (optional — for Base/Polygon/Blast drops) ──
BASE_RPC_PRIMARY=
BASE_RPC_BLAST_1=
POLYGON_RPC_PRIMARY=
BLAST_RPC_PRIMARY=

# ── Robinhood Chain (Arbitrum Orbit L2 · chainId 4663 · native ETH) ──
# If left blank, RV3 falls back to the public endpoint below automatically.
# For production use a provider (Alchemy): https://robinhood-mainnet.g.alchemy.com/v2/<KEY>
# Public (rate-limited): https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_PRIMARY=
ROBINHOOD_RPC_BLAST_1=

# Worker poll interval in ms (default 200 — lower = faster task pickup)
WORKER_TICK_MS=200

# ── Copy Mint ───────────────────────────────────────────
# How often (ms) the copy-mint watcher scans new blocks for target mints
COPYMINT_SCAN_MS=4000

# ── Alerts (optional) ───────────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live execution requires an approved external SignerProvider; RV3 never
# accepts or stores signing material.
ENABLE_LIVE_MINT=false

# ── Production external-signing safety gate ─────────────
# Never place signing material in this file. A hardware wallet, OS secure keystore,
# or managed signing service owns signing and only returns approved signatures.
RV3_EXTERNAL_SIGNER_PROVIDER=
# WalletConnect project ID for an external wallet pairing. Keep this server-side;
# pair only from a reviewed operator action and allowlist the deployed RV3 origin
# in the WalletConnect dashboard before production use.
WALLETCONNECT_PROJECT_ID=
# Public HTTPS origin served by RV3 in production; use localhost only for
# development. Allowlist this same origin in the WalletConnect dashboard.
RV3_PUBLIC_URL=
RV3_ALLOWED_CHAINS=ethereum,robinhood,base,blast,polygon
RV3_ALLOWED_CONTRACTS=
RV3_MAX_TX_VALUE_WEI=
RV3_DAILY_SPEND_WEI=
RV3_CIRCUIT_BREAKER=on

# Max tasks accepted per minute (server-side)
TASK_RATE_LIMIT_PER_MIN=10
